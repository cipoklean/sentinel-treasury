{
  "name": "sentinel",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Sentinel — an autonomous treasury agent bounded by QoreChain's post-quantum rails.",
  "scripts": {
    "forge-std": "forge install foundry-rs/forge-std --no-git",
    "build": "forge build",
    "test": "forge test",
    "window": "tsx --env-file=.env scripts/window.ts",
    "window:agent": "tsx --env-file=.env.agent scripts/window.ts",
    "send": "tsx --env-file=.env scripts/send.ts",
    "agent": "tsx --env-file=.env.agent.hot agent/index.ts",
    "guardian": "tsx --env-file=.env guardian/index.ts",
    "aa": "tsx scripts/aa.ts",
    "rotate-agent": "tsx scripts/rotate-agent.ts",
    "drill-evidence": "tsx scripts/drill-evidence.ts",
    "dashboard": "tsx dashboard/serve.ts",
    "receipts:export": "tsx scripts/export-receipts.ts",
    "snapshot": "tsx scripts/snapshot.ts",
    "deploy:testnet": "forge script script/Deploy.s.sol --rpc-url qorechain_testnet --broadcast",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@cosmjs/stargate": "^0.39.0",
    "@qorechain/evm": "^0.14.0",
    "@qorechain/sdk": "^0.14.0",
    "viem": "^2.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "tsx": "^4.19.0",
    "typescript": "^5.6.3"
  }
}
